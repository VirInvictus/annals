#!/usr/bin/env python3
"""Fetch registry download stats into the adoption cache.

The one networked piece of annals: the generator itself only reads the
cache this writes, so the no-network contract holds. Reads [adoption] from
annals.toml, merges each configured PyPI package's full daily history from
pypistats.org (both mirror bases in one request, split client-side), and
appends one dated cumulative snapshot per crates.io crate (crates.io has no
time-series API), then rewrites the cache atomically. A failing package
warns and exits 1 with its cached entry untouched; the nightly pipeline
retries the next day.

Usage: uv run scripts/fetch-adoption [--config PATH]
"""

from __future__ import annotations

import argparse
import json
import os
import sys
import tempfile
import urllib.request
from datetime import datetime, timezone
from pathlib import Path

from annals import __version__
from annals.adoption import (
    append_snapshot,
    load_cache,
    merge_pypi_days,
    parse_crates,
    parse_pypistats,
)
from annals.config import ConfigError, load_config

PYPISTATS_URL = "https://pypistats.org/api/packages/{name}/overall"
CRATES_API_URL = "https://crates.io/api/v1/crates/{name}"
# crates.io rejects requests without a User-Agent.
USER_AGENT = f"annals/{__version__} (+https://github.com/VirInvictus/annals)"


def _get_text(url: str) -> str:
    request = urllib.request.Request(url, headers={"User-Agent": USER_AGENT})
    with urllib.request.urlopen(request, timeout=30) as response:
        return response.read().decode("utf-8")


def _write_atomic(path: Path, cache: dict) -> None:
    """Deterministic bytes (sorted keys), swapped in with os.replace so a
    mid-write crash can never leave a half cache behind."""
    payload = json.dumps(cache, indent=1, sort_keys=True) + "\n"
    handle, tmp = tempfile.mkstemp(dir=path.parent, prefix=path.name, suffix=".tmp")
    try:
        with os.fdopen(handle, "w", encoding="utf-8") as stream:
            stream.write(payload)
        os.replace(tmp, path)
    except OSError:
        try:
            os.unlink(tmp)
        except OSError:
            pass
        raise


def main(argv: list[str] | None = None) -> int:
    parser = argparse.ArgumentParser(
        prog="fetch-adoption",
        description=(
            "Refresh the adoption cache from pypistats.org and crates.io."
        ),
    )
    parser.add_argument(
        "--config", type=Path, default=None, help="alternate annals.toml path"
    )
    args = parser.parse_args(argv)
    try:
        config = load_config(args.config)
    except ConfigError as exc:
        print(f"annals: {exc}", file=sys.stderr)
        return 2
    target = config.adoption
    if target is None:
        print(
            "annals: no [adoption] section with packages in the config;"
            " nothing to fetch",
            file=sys.stderr,
        )
        return 2

    if target.cache.exists():
        cache = load_cache(target.cache)
        if cache is None:
            print(
                f"annals: {target.cache} exists but is unreadable; fix or"
                " remove it first (its history is not overwritten)",
                file=sys.stderr,
            )
            return 2
    else:
        cache = {"version": 1, "packages": {}}
    packages = cache.setdefault("packages", {})

    failures = 0
    for name in target.pypi:
        try:
            fresh = parse_pypistats(_get_text(PYPISTATS_URL.format(name=name)))
        except (OSError, ValueError, KeyError) as exc:
            failures += 1
            print(
                f"annals: {name}: pypistats fetch failed ({exc});"
                " cached data kept",
                file=sys.stderr,
            )
            continue
        entry = packages.setdefault(f"pypi:{name}", {"days": {}})
        entry["days"] = merge_pypi_days(entry.get("days", {}), fresh)
        print(f"annals: {name}: pypistats merged")
    for name in target.crates:
        try:
            total = parse_crates(_get_text(CRATES_API_URL.format(name=name)))
        except (OSError, ValueError, KeyError) as exc:
            # An HTTPError 404 here is simply a crate not published yet.
            failures += 1
            print(
                f"annals: {name}: crates.io fetch failed ({exc});"
                " cached data kept",
                file=sys.stderr,
            )
            continue
        entry = packages.setdefault(f"crates:{name}", {"snapshots": {}})
        entry["snapshots"] = append_snapshot(
            entry.get("snapshots", {}), _utc_today(), total
        )
        print(f"annals: {name}: crates.io sample appended ({total:,} total)")

    cache["fetched_at"] = datetime.now(timezone.utc).isoformat(timespec="seconds")
    _write_atomic(target.cache, cache)
    print(f"annals: wrote {target.cache}")
    return 1 if failures else 0


def _utc_today() -> str:
    return datetime.now(timezone.utc).date().isoformat()


if __name__ == "__main__":
    raise SystemExit(main())
